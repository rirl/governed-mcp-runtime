# syntax=docker/dockerfile:1

FROM node:22.23.2-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96

ENV PATH="/opt/mcpo/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build

COPY docker/mcp/constraints.txt ./constraints.txt

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        python3 \
        python3-venv \
    && python3 -m venv /opt/mcpo \
    && /opt/mcpo/bin/pip install \
         --no-cache-dir \
         --constraint ./constraints.txt \
         "mcpo" \
         "mcp[cli]" \
    && npm install --global @modelcontextprotocol/server-filesystem@2026.8.31 \
    && apt-get purge --yes --auto-remove python3-venv \
    && rm -rf \
        /build/* \
        /var/lib/apt/lists/* \
        /root/.cache \
        /root/.npm

WORKDIR /

ENTRYPOINT ["mcpo"]
